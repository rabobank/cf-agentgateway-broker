<%
require 'json'
require 'uri'
encode = ->(v) { URI.encode_www_form_component(v.to_s).gsub('+', '%20') }
db = link('postgres')
host = db.instances.first.address
port = db.p('databases.port')
tls = {'cert' => '/var/vcap/jobs/agentgateway/config/tls.crt', 'key' => '/var/vcap/jobs/agentgateway/config/tls.key'}
%>
<%= JSON.pretty_generate({
  'config' => {
    'adminAddr' => '127.0.0.1:15000',
    'storage' => {'mode' => 'hybrid'},
    'database' => {'url' => "postgres://#{encode.call(p('gateway.database.username'))}:#{encode.call(p('gateway.database.password'))}@#{host}:#{port}/#{encode.call(p('gateway.database.name'))}?sslmode=#{encode.call(p('gateway.database.sslmode'))}"},
    'modelCatalog' => [{'file' => '/var/vcap/jobs/agentgateway/config/catalog.json'}]
  },
  'gateways' => {
    'inference' => {'port' => p('gateway.port'), 'tls' => tls},
    'management' => {'port' => p('gateway.management_port'), 'tls' => tls}
  },
  'llm' => {'gateways' => ['inference'], 'models' => p('gateway.models'), 'policies' => {
    'apiKey' => {'mode' => 'strict', 'keys' => []},
    'authorization' => {'rules' => ['(request.method == "GET" && request.path == "/v1/models") || (request.method == "POST" && request.path == "/v1/chat/completions")']}
  }},
  'ui' => {'gateways' => ['management'], 'policies' => {'apiKey' => {'mode' => 'strict', 'keys' => [{'key' => p('gateway.management_token')}]}}}
}) %>
