---
name: agentgateway
packages:
- agentgateway
- gateway-runtime
templates:
  config.json.erb: config/config.json
  bpm.yml.erb: config/bpm.yml
  certificate.erb: config/tls.crt
  private-key.erb: config/tls.key
  catalog.json.erb: config/catalog.json
consumes:
- name: postgres
  type: database
properties:
  gateway.port:
    description: HTTPS inference port
    default: 8443
  gateway.management_port:
    description: Private HTTPS management port
    default: 8444
  gateway.management_token:
    description: Management API key (distinct from tenant keys)
  gateway.database.name:
    description: PostgreSQL database name
    default: agentgateway
  gateway.database.username:
    description: PostgreSQL schema-owner role
    default: agentgateway
  gateway.database.password:
    description: PostgreSQL password
  gateway.database.sslmode:
    description: PostgreSQL TLS mode (disable for initial private homelab network)
    default: disable
  gateway.models:
    description: Native agentgateway LLM model configurations, including provider credentials
  gateway.catalog:
    description: Native model cost catalog JSON object
  gateway.tls.certificate:
    description: Certificate covering inference and management DNS aliases
  gateway.tls.private_key:
    description: TLS private key PEM
