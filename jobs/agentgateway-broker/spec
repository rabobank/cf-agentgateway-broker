---
name: agentgateway-broker
packages:
- agentgateway-broker
templates:
  config.json.erb: config/config.json
  bpm.yml.erb: config/bpm.yml
  certificate.erb: config/tls.crt
  private-key.erb: config/tls.key
  ca.erb: config/ca.crt
properties:
  broker.port:
    description: OSB HTTPS port
    default: 8443
  broker.username:
    description: OSB Basic authentication username
    default: broker
  broker.password:
    description: OSB Basic authentication password
  broker.installation:
    description: Stable broker installation label
    default: agentgateway-broker
  broker.gateway_url:
    description: App-facing HTTPS URL including /v1
  broker.management_url:
    description: Private gateway management HTTPS URL
  broker.management_token:
    description: Gateway management API key
  broker.service_id:
    description: Stable service UUID
    default: 1b0b97a6-41df-4a39-9b23-53f17a5f85be
  broker.plan_id:
    description: Stable plan UUID
    default: eba8b5b0-e8a7-49cb-8188-cfa52ed43bdd
  broker.models:
    description: Exact gateway model aliases
  broker.budget:
    description: Positive decimal USD allowance
    default: 10
  broker.window:
    description: Epoch-aligned budget duration
    default: 24h
  broker.tls.certificate:
    description: Broker server certificate PEM
  broker.tls.private_key:
    description: Broker private key PEM
  broker.tls.ca:
    description: Management listener trust CA PEM
