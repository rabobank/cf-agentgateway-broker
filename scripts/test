#!/usr/bin/env bash
set -euo pipefail
pushd src/agentgateway-broker >/dev/null
go test -race ./...
go vet ./...
popd >/dev/null
pushd src/capsule-extmcp >/dev/null
GOTOOLCHAIN=go1.27.0 go run github.com/onsi/ginkgo/v2/ginkgo -r --randomize-all --randomize-suites --fail-on-pending --fail-on-empty --keep-going --cover --race --trace --json-report=report.json --junit-report=junit.xml --output-dir="${TEST_REPORT_DIR:-/tmp/agentgateway-capsule-reports}" --timeout=5m --poll-progress-after=1m --poll-progress-interval=30s
GOTOOLCHAIN=go1.27.0 go vet ./...
popd >/dev/null
pushd src/cf-launcher >/dev/null
go test -race ./...
go vet ./...
popd >/dev/null
