#!/usr/bin/env bash
set -euo pipefail
pushd src/agentgateway >/dev/null
vendor_dir="$(pwd)/../agentgateway-vendor/crates"
cargo --config ../agentgateway-vendor/config.toml --config "source.vendored-sources.directory=\"${vendor_dir}\"" metadata --frozen --format-version 1 >/dev/null
export VERSION=main-c0354ea4 GIT_REVISION=c0354ea426b25b4b3df357ba4b6afabcf4309660
cargo --config ../agentgateway-vendor/config.toml --config "source.vendored-sources.directory=\"${vendor_dir}\"" build --frozen --release -p agentgateway-app --bin agentgateway
popd >/dev/null
