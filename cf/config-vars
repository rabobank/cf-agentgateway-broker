#!/usr/bin/env python3
"""Convert application YAML to a CF vars object containing one JSON string.

Usage: python3 config-vars broker_config broker.yml
Requires PyYAML (see requirements.txt). Diagnostics never include input values.
"""
import json
import math
import sys

import yaml


class UniqueLoader(yaml.SafeLoader):
    pass


def mapping(loader, node, deep=False):
    result = {}
    for key_node, value_node in node.value:
        key = loader.construct_object(key_node, deep=deep)
        if not isinstance(key, str) or key in result:
            raise ValueError("duplicate or non-string key")
        result[key] = loader.construct_object(value_node, deep=deep)
    return result


UniqueLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, mapping)


def validate(value, ancestors=None):
    ancestors = set() if ancestors is None else ancestors
    if isinstance(value, (dict, list)):
        if id(value) in ancestors:
            raise ValueError("recursive aliases")
        ancestors = ancestors | {id(value)}
        for item in (value.values() if isinstance(value, dict) else value):
            validate(item, ancestors)
    elif value is not None and type(value) not in (str, bool, int, float):
        raise ValueError("non-JSON value")
    elif isinstance(value, float) and not math.isfinite(value):
        raise ValueError("nonfinite number")


def main():
    try:
        if len(sys.argv) == 4 and sys.argv[1] == "--check":
            broker, gateway = (load(path) for path in sys.argv[2:])
            check_references(broker, gateway)
            return 0
        if len(sys.argv) != 3 or sys.argv[1] not in ("broker_config", "gateway_config"):
            raise ValueError("arguments")
        value = load(sys.argv[2])
        payload = json.dumps(value, separators=(",", ":"), allow_nan=False)
        print(json.dumps({sys.argv[1]: payload}))
    except ContractError as error:
        print(str(error), file=sys.stderr)
        return 1
    except Exception:
        print("Configuration conversion failed: expected one JSON-compatible YAML object with unique string keys", file=sys.stderr)
        return 1
    return 0


class ContractError(ValueError):
    pass


def load(path):
    with open(path) as source:
        value = yaml.load(source, Loader=UniqueLoader)
    if not isinstance(value, dict):
        raise ValueError("object required")
    validate(value)
    return value


def check_references(broker, gateway):
    models = {m["name"] for m in gateway.get("llm", {}).get("models", [])}
    backends = {b["name"]: b for b in gateway.get("mcp", {}).get("backends", [])}
    if broker.get("installation") != gateway.get("capsules", {}).get("log_id"):
        raise ContractError("broker installation must match capsule log_id")
    for service in broker.get("services", []):
        for plan in service.get("plans", []):
            access = plan.get("access", {})
            if any(name not in models for name in access.get("models", [])):
                raise ContractError("plan references unknown model")
            if any(name not in backends for name in access.get("backends", [])):
                raise ContractError("plan references unknown MCP backend")
            schema = plan.get("schemas", {}).get("service_instance", {}).get("create", {}).get("parameters", {})
            for name in access.get("backends", []):
                for target in backends[name]["mcp"]["targets"]:
                    client = target.get("policies", {}).get("backendAuth", {}).get("oauthTokenExchange", {}).get("clientAuth", {}).get("clientId")
                    if isinstance(client, dict):
                        parameter = client.get("fromInstanceParameter")
                        if parameter not in schema.get("properties", {}) or parameter not in schema.get("required", []):
                            raise ContractError("backend identity reference must be a required instance parameter")


if __name__ == "__main__":
    sys.exit(main())
