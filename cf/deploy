#!/usr/bin/env python3
"""Deploy with a broker-only identity route: deploy GATEWAY BROKER DOMAIN HOST [cf push options]."""
import json
import subprocess
import sys
from urllib.parse import quote, urlsplit


def cf(*args):
    return subprocess.check_output(["cf", *args], text=True)


def run(*args):
    subprocess.run(["cf", *args], check=True)


def main():
    if len(sys.argv) < 5:
        raise SystemExit(__doc__)
    gateway, broker, domain, host = sys.argv[1:5]
    if any(arg in ("--no-start", "--no-route", "--random-route") for arg in sys.argv[5:]):
        raise SystemExit("The deployment helper controls app startup and routes; supply only configuration options")
    domains = json.loads(cf("curl", "/v3/domains?names=" + quote(domain)))["resources"]
    if len(domains) != 1 or not domains[0].get("enforce_route_policies"):
        raise SystemExit("Management domain must enforce route policies")
    # Create both app GUIDs before resolving the source policy. Map the extra
    # destination port before starting/replacing gateway containers.
    run("push", "-f", "manifest.yml", *sys.argv[5:], "--no-start", "--redact-env")
    broker_guid = cf("app", broker, "--guid").strip()
    env = json.loads(cf("curl", "/v3/apps/" + broker_guid + "/environment_variables"))["var"]
    url = urlsplit(env.get("MANAGEMENT_URL", ""))
    if url.scheme != "https" or url.hostname != host + "." + domain or url.port not in (None, 443) or url.path not in ("", "/") or url.username or url.query or url.fragment:
        raise SystemExit("MANAGEMENT_URL must match the HTTPS identity route on port 443")
    run("map-route", gateway, domain, "--hostname", host, "--app-port", "9090")
    source = "cf:app:" + broker_guid
    routes = json.loads(cf("curl", "/v3/routes?hosts=" + quote(host) + "&domain_guids=" + domains[0]["guid"]))["resources"]
    if len(routes) != 1:
        raise SystemExit("Expected one management route")
    route = routes[0]
    gateway_guid = cf("app", gateway, "--guid").strip()
    if any(d["app"]["guid"] != gateway_guid or d["port"] != 9090 for d in route["destinations"]):
        raise SystemExit("Management route has unexpected destinations")
    policies = json.loads(cf("curl", "/v3/route_policies?route_guids=" + route["guid"] + "&per_page=5000"))["resources"]
    # Refuse an existing broad grant instead of accidentally exposing management.
    if any(policy["source"] != source for policy in policies):
        raise SystemExit("Management route has unexpected callers; reconcile its route policies first")
    if not policies:
        run("add-route-policy", domain, "--hostname", host, "--source-app", broker)
    for app in (gateway, broker):
        run("unset-env", app, "MANAGEMENT_TOKEN")
    run("restart", gateway, "--strategy", "rolling")
    run("restart", broker, "--strategy", "rolling")


if __name__ == "__main__":
    main()
